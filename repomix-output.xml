'use client';

import { useState } from 'react';
import { useRouter } from 'next/navigation';
import { createClient } from '@/lib/supabase/client';
import { 
  ArrowRight, 
  CheckCircle2, 
  Sparkles, 
  Loader2, 
  Phone, 
  Check 
} from 'lucide-react';

export default function OnboardingPage() {
  const [step, setStep] = useState(1);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState<string | null>(null);

  const [businessName, setBusinessName] = useState('');
  const [slug, setSlug] = useState('');
  const [category, setCategory] = useState('Calzado y Moda');
  const [phoneWhatsapp, setPhoneWhatsapp] = useState('');

  const router = useRouter();
  const supabase = createClient();

  const handleSlugChange = (text: string) => {
    const formatted = text
      .toLowerCase()
      .replace(/[^a-z0-9-]/g, '')
      .replace(/\s+/g, '-');
    setSlug(formatted);
  };

  const handleCompleteOnboarding = async () => {
    setLoading(true);
    setError(null);

    try {
      const { data: { user } } = await supabase.auth.getUser();

      if (!user) throw new Error('Usuario no autenticado.');

      const { error: updateError } = await (supabase
        .from('profiles') as any)
        .update({
       business_name: businessName,
       slug,
       category_niche: category,
       phone_whatsapp: phoneWhatsapp,
        subscription_status: 'trialing',
       trial_ends_at: new Date(Date.now() + 14 * 24 * 60 * 60 * 1000).toISOString(),
     })
        .eq('id', user.id);
      if (updateError) throw updateError;

      router.push('/dashboard');
      router.refresh();
    } catch (err: any) {
      setError(err.message || 'Ocurrió un error al guardar los datos.');
      setLoading(false);
    }
  };

  return (
    <div className="min-h-screen bg-[#F8FAFC] flex flex-col justify-center py-12 px-4 sm:px-6 lg:px-8">
      <div className="sm:mx-auto sm:w-full sm:max-w-lg">
        <div className="flex items-center justify-between mb-8 px-4">
          {[1, 2, 3].map((s) => (
            <div key={s} className="flex items-center gap-2">
              <div
                className={`w-9 h-9 rounded-full flex items-center justify-center font-bold text-sm transition-all ${
                  step === s
                    ? 'bg-[#0A2540] text-[#00D2FF] ring-4 ring-cyan-100'
                    : step > s
                    ? 'bg-[#22C55E] text-white'
                    : 'bg-slate-200 text-slate-500'
                }`}
              >
                {step > s ? <Check className="w-5 h-5" /> : s}
              </div>
              <span className="text-xs font-semibold text-slate-600 hidden sm:inline">
                {s === 1 ? 'Negocio' : s === 2 ? 'Contacto' : 'Activación'}
              </span>
            </div>
          ))}
        </div>

        <div className="bg-white py-8 px-6 shadow-sm border border-slate-200 rounded-3xl sm:px-10">
          {error && (
            <div className="mb-6 p-3.5 text-xs text-red-600 bg-red-50 border border-red-200 rounded-xl font-medium">
              {error}
            </div>
          )}

          {step === 1 && (
            <div className="space-y-5">
              <div>
                <h3 className="text-xl font-black text-[#0A2540]">Detalles del Negocio</h3>
                <p className="text-xs text-slate-500 mt-1">
                  Ingresa el nombre y tu enlace público único
                </p>
              </div>

              <div>
                <label className="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">
                  Nombre de tu Empresa / Tienda
                </label>
                <input
                  type="text"
                  required
                  value={businessName}
                  onChange={(e) => {
                    setBusinessName(e.target.value);
                    if (!slug) handleSlugChange(e.target.value);
                  }}
                  className="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-[#00D2FF]"
                  placeholder="Ej. Reality Shop"
                />
              </div>

              <div>
                <label className="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">
                  Enlace Web Único (Slug)
                </label>
                <div className="flex items-center bg-slate-50 border border-slate-200 rounded-xl overflow-hidden px-3 py-3">
                  <span className="text-xs text-slate-400 font-semibold">mercadeo.app/</span>
                  <input
                    type="text"
                    required
                    value={slug}
                    onChange={(e) => handleSlugChange(e.target.value)}
                    className="w-full bg-transparent text-slate-800 text-sm font-bold focus:outline-none ml-1"
                    placeholder="reality-shop"
                  />
                </div>
              </div>

              <div>
                <label className="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">
                  Categoría o Nicho
                </label>
                <select
                  value={category}
                  onChange={(e) => setCategory(e.target.value)}
                  className="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-[#00D2FF]"
                >
                  <option value="Calzado y Moda">Calzado y Moda</option>
                  <option value="Electrónica y Tecnología">Electrónica y Tecnología</option>
                  <option value="Perfumería y Cosmética">Perfumería y Cosmética</option>
                  <option value="Alimentos y Bebidas">Alimentos y Bebidas</option>
                  <option value="Servicios Profesionales">Servicios Profesionales</option>
                  <option value="Otro">Otro</option>
                </select>
              </div>

              <button
                onClick={() => {
                  if (!businessName || !slug) {
                    setError('Por favor completa todos los campos requeridos.');
                    return;
                  }
                  setError(null);
                  setStep(2);
                }}
                className="w-full flex justify-center items-center gap-2 py-3.5 px-4 rounded-xl text-white font-bold bg-[#0A2540] hover:bg-slate-800 transition-colors shadow-sm mt-6"
              >
                Siguiente Paso <ArrowRight className="w-4 h-4" />
              </button>
            </div>
          )}

          {step === 2 && (
            <div className="space-y-5">
              <div>
                <h3 className="text-xl font-black text-[#0A2540]">Canal de Ventas</h3>
                <p className="text-xs text-slate-500 mt-1">
                  Agrega tu WhatsApp para recibir los pedidos directos del catálogo
                </p>
              </div>

              <div>
                <label className="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">
                  Número de WhatsApp para Pedidos
                </label>
                <div className="relative">
                  <Phone className="w-5 h-5 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2" />
                  <input
                    type="text"
                    required
                    value={phoneWhatsapp}
                    onChange={(e) => setPhoneWhatsapp(e.target.value)}
                    className="w-full pl-11 pr-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-[#00D2FF]"
                    placeholder="+584121234567"
                  />
                </div>
                <span className="text-[11px] text-slate-400 mt-1.5 block">
                  Incluye el código de país (Ej: +58 para Venezuela)
                </span>
              </div>

              <div className="flex gap-3 pt-4">
                <button
                  type="button"
                  onClick={() => setStep(1)}
                  className="w-1/3 py-3.5 px-4 rounded-xl text-slate-600 font-bold bg-slate-100 hover:bg-slate-200 transition-colors text-sm"
                >
                  Atrás
                </button>
                <button
                  type="button"
                  onClick={() => {
                    if (!phoneWhatsapp) {
                      setError('Por favor ingresa tu número de WhatsApp.');
                      return;
                    }
                    setError(null);
                    setStep(3);
                  }}
                  className="w-2/3 flex justify-center items-center gap-2 py-3.5 px-4 rounded-xl text-white font-bold bg-[#0A2540] hover:bg-slate-800 transition-colors shadow-sm"
                >
                  Siguiente Paso <ArrowRight className="w-4 h-4" />
                </button>
              </div>
            </div>
          )}

          {step === 3 && (
            <div className="space-y-6">
              <div className="text-center">
                <div className="mx-auto w-12 h-12 bg-cyan-50 border border-cyan-200 text-[#00D2FF] rounded-2xl flex items-center justify-center mb-3">
                  <Sparkles className="w-6 h-6" />
                </div>
                <h3 className="text-xl font-black text-[#0A2540]">¡Todo listo para empezar!</h3>
                <p className="text-xs text-slate-500 mt-1">
                  Tu prueba gratuita de 14 días incluye acceso a todas las funciones
                </p>
              </div>

              <div className="bg-slate-50 border border-slate-200 rounded-2xl p-5 space-y-3">
                <div className="flex items-center justify-between pb-3 border-b border-slate-200">
                  <span className="text-xs font-bold text-slate-500 uppercase">Resumen del Plan</span>
                  <span className="text-sm font-black text-[#22C55E] bg-green-50 border border-green-200 px-2.5 py-0.5 rounded-full">
                    $0 HOY
                  </span>
                </div>

                <ul className="space-y-2 text-xs text-slate-600">
                  <li className="flex items-center gap-2">
                    <CheckCircle2 className="w-4 h-4 text-[#22C55E]" /> 14 Días de acceso ilimitado
                  </li>
                  <li className="flex items-center gap-2">
                    <CheckCircle2 className="w-4 h-4 text-[#22C55E]" /> Punto de Venta (POS Móvil) & Inventario
                  </li>
                  <li className="flex items-center gap-2">
                    <CheckCircle2 className="w-4 h-4 text-[#22C55E]" /> Catálogo Web e Integración con WhatsApp
                  </li>
                  <li className="flex items-center gap-2">
                    <CheckCircle2 className="w-4 h-4 text-[#22C55E]" /> Copiloto de IA para Negocios
                  </li>
                </ul>

                <p className="text-[11px] text-slate-400 pt-2 border-t border-slate-200">
                  Renovación por $19.99/mes mediante Pago Móvil o Binance Pay al terminar la prueba.
                </p>
              </div>

              <div className="flex gap-3">
                <button
                  type="button"
                  onClick={() => setStep(2)}
                  className="w-1/3 py-3.5 px-4 rounded-xl text-slate-600 font-bold bg-slate-100 hover:bg-slate-200 transition-colors text-sm"
                >
                  Atrás
                </button>
                <button
                  type="button"
                  onClick={handleCompleteOnboarding}
                  disabled={loading}
                  className="w-2/3 flex justify-center items-center gap-2 py-3.5 px-4 rounded-xl text-white font-bold bg-[#0A2540] hover:bg-slate-800 disabled:opacity-50 transition-colors shadow-sm"
                >
                  {loading ? (
                    <Loader2 className="w-5 h-5 animate-spin" />
                  ) : (
                    <>
                      Entrar al Dashboard <ArrowRight className="w-4 h-4" />
                    </>
                  )}
                </button>
              </div>
            </div>
          )}
        </div>
      </div>
    </div>
  );
}
