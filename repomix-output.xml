<file path="middleware.ts">
import { NextResponse, type NextRequest } from 'next/server';
import { createServerClient } from '@supabase/ssr';

export async function middleware(request: NextRequest) {
  let response = NextResponse.next({
    request: {
      headers: request.headers,
    },
  });

  const supabase = createServerClient(
    process.env.NEXT_PUBLIC_SUPABASE_URL!,
    process.env.NEXT_PUBLIC_SUPABASE_ANON_KEY!,
    {
      cookies: {
        getAll() {
          return request.cookies.getAll();
        },
        setAll(cookiesToSet) {
          cookiesToSet.forEach(({ name, value }) =>
            request.cookies.set(name, value)
          );
          response = NextResponse.next({
            request,
          });
          cookiesToSet.forEach(({ name, value, options }) =>
            response.cookies.set(name, value, options)
          );
        },
      },
    }
  );

  const {
    data: { user },
  } = await supabase.auth.getUser();

  const isAuthRoute =
    request.nextUrl.pathname.startsWith('/login') ||
    request.nextUrl.pathname.startsWith('/register');
  const isDashboardRoute = request.nextUrl.pathname.startsWith('/dashboard');
  const isOnboardingRoute = request.nextUrl.pathname.startsWith('/onboarding');
  const isExpiredRoute = request.nextUrl.pathname.startsWith('/billing/expired');

  if (!user && isDashboardRoute) {
    return NextResponse.redirect(new URL('/login', request.url));
  }

  if (user) {
    if (isAuthRoute) {
      return NextResponse.redirect(new URL('/dashboard', request.url));
    }

    const { data: profile } = await (supabase.from('profiles') as any)
      .select('subscription_status, trial_ends_at, business_name')
      .eq('id', user.id)
      .single();

    if (profile && !profile.business_name && !isOnboardingRoute) {
      return NextResponse.redirect(new URL('/onboarding', request.url));
    }

    if (profile && isDashboardRoute) {
      const now = new Date();
      const trialEnds = profile.trial_ends_at ? new Date(profile.trial_ends_at) : null;
      const isExpired =
        profile.subscription_status === 'expired' ||
        (profile.subscription_status === 'trialing' && trialEnds && trialEnds < now);

      if (isExpired && !isExpiredRoute) {
        return NextResponse.redirect(new URL('/billing/expired', request.url));
      }
    }
  }

  return response;
}

export const config = {
  matcher: [
    '/dashboard/:path*',
    '/onboarding',
    '/login',
    '/register',
    '/billing/expired',
  ],
};
</file>

