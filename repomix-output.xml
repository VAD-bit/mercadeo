<file path="app/(dashboard)/dashboard/pos/page.tsx">
'use client';

import { useState, useEffect } from 'react';
import { createClient } from '@/lib/supabase/client';
import { 
  Search, 
  ShoppingCart, 
  Trash2, 
  Plus, 
  Minus, 
  CheckCircle2, 
  Loader2, 
  DollarSign, 
  CreditCard, 
  Receipt 
} from 'lucide-react';

interface Product {
  id: string;
  name: string;
  price_usd: number;
  stock: number;
  image_url: string | null;
}

interface CartItem extends Product {
  quantity: number;
}

export default function POSPage() {
  const [products, setProducts] = useState<Product[]>([]);
  const [cart, setCart] = useState<CartItem[]>([]);
  const [search, setSearch] = useState('');
  const [loading, setLoading] = useState(true);
  const [processing, setProcessing] = useState(false);
  const [paymentMethod, setPaymentMethod] = useState<'efectivo' | 'pago_movil' | 'zelle'>('efectivo');
  const [saleSuccess, setSaleSuccess] = useState(false);

  const supabase = createClient();

  const fetchProducts = async () => {
    setLoading(true);
    const { data } = await (supabase.from('products') as any)
      .select('*')
      .gt('stock', 0)
      .order('name', { ascending: true });

    if (data) setProducts(data);
    setLoading(false);
  };

  useEffect(() => {
    fetchProducts();
  }, []);

  const addToCart = (product: Product) => {
    setCart((prev) => {
      const existing = prev.find((item) => item.id === product.id);
      if (existing) {
        if (existing.quantity >= product.stock) return prev;
        return prev.map((item) =>
          item.id === product.id
            ? { ...item, quantity: item.quantity + 1 }
            : item
        );
      }
      return [...prev, { ...product, quantity: 1 }];
    });
  };

  const updateQuantity = (id: string, delta: number) => {
    setCart((prev) =>
      prev
        .map((item) => {
          if (item.id === id) {
            const newQty = item.quantity + delta;
            const originalProduct = products.find((p) => p.id === id);
            if (newQty <= 0) return null;
            if (originalProduct && newQty > originalProduct.stock) return item;
            return { ...item, quantity: newQty };
          }
          return item;
        })
        .filter(Boolean) as CartItem[]
    );
  };

  const removeFromCart = (id: string) => {
    setCart((prev) => prev.filter((item) => item.id !== id));
  };

  const total = cart.reduce(
    (sum, item) => sum + item.price_usd * item.quantity,
    0
  );

  const handleCheckout = async () => {
    if (cart.length === 0) return;
    setProcessing(true);

    try {
      const { data: { user } } = await supabase.auth.getUser();
      if (!user) throw new Error('Usuario no autenticado');

      // 1. Registrar Orden
      const { data: order, error: orderError } = await (
        supabase.from('orders') as any
      )
        .insert([
          {
            business_id: user.id,
            total_usd: total,
            payment_method: paymentMethod,
            status: 'completed',
          },
        ])
        .select()
        .single();

      if (orderError) throw orderError;

      // 2. Registrar items de la orden y actualizar Stock
      for (const item of cart) {
        await (supabase.from('order_items') as any).insert([
          {
            order_id: order.id,
            product_id: item.id,
            quantity: item.quantity,
            price_usd: item.price_usd,
          },
        ]);

        const newStock = item.stock - item.quantity;
        await (supabase.from('products') as any)
          .update({ stock: newStock })
          .eq('id', item.id);
      }

      setCart([]);
      setSaleSuccess(true);
      fetchProducts();
      setTimeout(() => setSaleSuccess(false), 3000);
    } catch (err: any) {
      alert(err.message || 'Error al procesar la venta');
    } finally {
      setProcessing(false);
    }
  };

  const filteredProducts = products.filter((p) =>
    p.name.toLowerCase().includes(search.toLowerCase())
  );

  return (
    <div className="grid grid-cols-1 lg:grid-cols-3 gap-6 max-w-7xl mx-auto h-[calc(100vh-6rem)]">
      {/* Catálogo de Productos */}
      <div className="lg:col-span-2 flex flex-col space-y-4">
        <div>
          <h1 className="text-2xl font-black text-[#0A2540]">Punto de Venta</h1>
          <p className="text-xs text-slate-500 mt-0.5">
            Selecciona productos para armar el pedido de cobro directo.
          </p>
        </div>

        <div className="relative">
          <Search className="w-4 h-4 text-slate-400 absolute left-4 top-3.5" />
          <input
            type="text"
            value={search}
            onChange={(e) => setSearch(e.target.value)}
            placeholder="Buscar por nombre..."
            className="w-full pl-11 pr-4 py-3 bg-white border border-slate-200 rounded-xl text-xs text-slate-800 focus:outline-none focus:ring-2 focus:ring-[#00D2FF]"
          />
        </div>

        <div className="flex-1 overflow-y-auto pr-1">
          {loading ? (
            <div className="flex justify-center py-12">
              <Loader2 className="w-6 h-6 text-[#0A2540] animate-spin" />
            </div>
          ) : (
            <div className="grid grid-cols-2 sm:grid-cols-3 gap-3">
              {filteredProducts.map((product) => (
                <button
                  key={product.id}
                  onClick={() => addToCart(product)}
                  className="bg-white border border-slate-200 hover:border-[#00D2FF] p-3 rounded-2xl text-left transition-all shadow-sm flex flex-col justify-between group"
                >
                  <div className="w-full h-24 bg-slate-50 rounded-xl overflow-hidden mb-2 border border-slate-100 flex items-center justify-center">
                    {product.image_url ? (
                      <img
                        src={product.image_url}
                        alt={product.name}
                        className="w-full h-full object-cover group-hover:scale-105 transition-transform"
                      />
                    ) : (
                      <Receipt className="w-6 h-6 text-slate-300" />
                    )}
                  </div>
                  <div>
                    <h3 className="text-xs font-bold text-[#0A2540] truncate">
                      {product.name}
                    </h3>
                    <div className="flex items-center justify-between mt-2">
                      <span className="text-xs font-black text-[#0A2540]">
                        ${product.price_usd.toFixed(2)}
                      </span>
                      <span className="text-[10px] text-slate-400 font-medium">
                        Stock: {product.stock}
                      </span>
                    </div>
                  </div>
                </button>
              ))}
            </div>
          )}
        </div>
      </div>

      {/* Carrito / Ticket de Cobro */}
      <div className="bg-white border border-slate-200 rounded-3xl p-5 shadow-sm flex flex-col justify-between">
        <div className="space-y-4 overflow-hidden flex flex-col">
          <div className="flex items-center justify-between pb-3 border-b border-slate-100">
            <div className="flex items-center gap-2">
              <ShoppingCart className="w-4 h-4 text-[#00D2FF]" />
              <h2 className="text-sm font-bold text-[#0A2540]">
                Orden de Venta
              </h2>
            </div>
            {cart.length > 0 && (
              <button
                onClick={() => setCart([])}
                className="text-[10px] text-red-500 font-bold hover:underline"
              >
                Vaciar
              </button>
            )}
          </div>

          {/* Items Seleccionados */}
          <div className="flex-1 overflow-y-auto space-y-3 pr-1 min-h-[220px]">
            {cart.length === 0 ? (
              <div className="h-full flex flex-col items-center justify-center text-center text-slate-400 py-12 space-y-2">
                <Receipt className="w-8 h-8 stroke-1" />
                <p className="text-xs">No hay productos en la orden</p>
              </div>
            ) : (
              cart.map((item) => (
                <div
                  key={item.id}
                  className="flex items-center justify-between p-2.5 bg-slate-50 rounded-xl text-xs"
                >
                  <div className="flex-1 pr-2 truncate">
                    <p className="font-bold text-[#0A2540] truncate">
                      {item.name}
                    </p>
                    <p className="text-[10px] text-slate-400">
                      ${item.price_usd.toFixed(2)} c/u
                    </p>
                  </div>

                  <div className="flex items-center gap-2">
                    <div className="flex items-center border border-slate-200 rounded-lg bg-white">
                      <button
                        onClick={() => updateQuantity(item.id, -1)}
                        className="p-1 hover:bg-slate-100 text-slate-600 rounded-l-lg"
                      >
                        <Minus className="w-3 h-3" />
                      </button>
                      <span className="px-2 font-bold text-xs">
                        {item.quantity}
                      </span>
                      <button
                        onClick={() => updateQuantity(item.id, 1)}
                        className="p-1 hover:bg-slate-100 text-slate-600 rounded-r-lg"
                      >
                        <Plus className="w-3 h-3" />
                      </button>
                    </div>

                    <button
                      onClick={() => removeFromCart(item.id)}
                      className="text-slate-400 hover:text-red-500 p-1"
                    >
                      <Trash2 className="w-3.5 h-3.5" />
                    </button>
                  </div>
                </div>
              ))
            )}
          </div>
        </div>

        {/* Sección de Pago */}
        <div className="space-y-4 pt-4 border-t border-slate-100 mt-auto">
          <div>
            <label className="block text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-2">
              Método de Pago
            </label>
            <div className="grid grid-cols-3 gap-2">
              {[
                { id: 'efectivo', label: 'Efectivo', icon: DollarSign },
                { id: 'pago_movil', label: 'Pago Móvil', icon: CreditCard },
                { id: 'zelle', label: 'Zelle', icon: CreditCard },
              ].map((m) => {
                const Icon = m.icon;
                const active = paymentMethod === m.id;
                return (
                  <button
                    key={m.id}
                    onClick={() => setPaymentMethod(m.id as any)}
                    className={`flex flex-col items-center gap-1 p-2 rounded-xl border text-[10px] font-bold transition-all ${
                      active
                        ? 'border-[#00D2FF] bg-cyan-50/50 text-[#0A2540]'
                        : 'border-slate-200 text-slate-500 hover:bg-slate-50'
                    }`}
                  >
                    <Icon className="w-3.5 h-3.5" />
                    <span>{m.label}</span>
                  </button>
                );
              })}
            </div>
          </div>

          <div className="flex items-center justify-between py-2 border-y border-slate-100">
            <span className="text-xs font-bold text-slate-500">Total a Cobrar</span>
            <span className="text-xl font-black text-[#0A2540]">
              ${total.toFixed(2)}
            </span>
          </div>

          {saleSuccess && (
            <div className="flex items-center gap-2 p-2.5 bg-emerald-50 text-emerald-700 rounded-xl text-xs font-bold">
              <CheckCircle2 className="w-4 h-4 shrink-0" />
              <span>¡Venta registrada con éxito!</span>
            </div>
          )}

          <button
            onClick={handleCheckout}
            disabled={processing || cart.length === 0}
            className="w-full flex justify-center items-center gap-2 py-3 px-4 rounded-xl text-white font-bold text-xs bg-[#0A2540] hover:bg-slate-800 disabled:opacity-50 transition-colors shadow-sm"
          >
            {processing ? (
              <Loader2 className="w-4 h-4 animate-spin" />
            ) : (
              `Completar Venta (${cart.length})`
            )}
          </button>
        </div>
      </div>
    </div>
  );
}
</file>

<file path="app/(dashboard)/dashboard/settings/page.tsx">
'use client';

import { useState, useEffect } from 'react';
import { createClient } from '@/lib/supabase/client';
import { 
  Building2, 
  Phone, 
  Globe, 
  CreditCard, 
  Save, 
  Loader2, 
  CheckCircle2 
} from 'lucide-react';

interface ProfileData {
  business_name: string;
  phone: string;
  slug: string;
  subscription_status: string;
  trial_ends_at: string | null;
}

export default function SettingsPage() {
  const [profile, setProfile] = useState<ProfileData>({
    business_name: '',
    phone: '',
    slug: '',
    subscription_status: 'trialing',
    trial_ends_at: null,
  });
  const [loading, setLoading] = useState(true);
  const [saving, setSaving] = useState(false);
  const [successMsg, setSuccessMsg] = useState(false);

  const supabase = createClient();

  useEffect(() => {
    const fetchProfile = async () => {
      setLoading(true);
      const { data: { user } } = await supabase.auth.getUser();

      if (user) {
        const { data } = await (supabase.from('profiles') as any)
          .select('business_name, phone, slug, subscription_status, trial_ends_at')
          .eq('id', user.id)
          .single();

        if (data) {
          setProfile({
            business_name: data.business_name || '',
            phone: data.phone || '',
            slug: data.slug || '',
            subscription_status: data.subscription_status || 'trialing',
            trial_ends_at: data.trial_ends_at || null,
          });
        }
      }
      setLoading(false);
    };

    fetchProfile();
  }, []);

  const handleSave = async (e: React.FormEvent) => {
    e.preventDefault();
    setSaving(true);
    setSuccessMsg(false);

    try {
      const { data: { user } } = await supabase.auth.getUser();
      if (!user) throw new Error('No autenticado');

      const cleanSlug = profile.slug.toLowerCase().trim().replace(/[^a-z0-9-]/g, '-');

      const { error } = await (supabase.from('profiles') as any)
        .update({
          business_name: profile.business_name,
          phone: profile.phone,
          slug: cleanSlug,
        })
        .eq('id', user.id);

      if (error) throw error;

      setProfile((prev) => ({ ...prev, slug: cleanSlug }));
      setSuccessMsg(true);
      setTimeout(() => setSuccessMsg(false), 3000);
    } catch (err: any) {
      alert(err.message || 'Error al guardar la configuración');
    } finally {
      setSaving(false);
    }
  };

  if (loading) {
    return (
      <div className="flex justify-center py-12">
        <Loader2 className="w-6 h-6 text-[#0A2540] animate-spin" />
      </div>
    );
  }

  return (
    <div className="max-w-4xl mx-auto space-y-8">
      <div>
        <h1 className="text-2xl font-black text-[#0A2540]">Configuración</h1>
        <p className="text-xs text-slate-500 mt-0.5">
          Gestiona los datos de tu negocio y la información de tu suscripción.
        </p>
      </div>

      <div className="grid grid-cols-1 md:grid-cols-3 gap-6">
        {/* Formulario de Perfil del Negocio */}
        <div className="md:col-span-2 bg-white border border-slate-200 rounded-3xl p-6 shadow-sm space-y-5">
          <h2 className="text-sm font-bold text-[#0A2540] border-b border-slate-100 pb-3">
            Perfil del Negocio
          </h2>

          <form onSubmit={handleSave} className="space-y-4">
            <div>
              <label className="block text-[11px] font-bold text-slate-700 uppercase tracking-wider mb-1">
                Nombre de la Empresa / Marca
              </label>
              <div className="relative">
                <Building2 className="w-4 h-4 text-slate-400 absolute left-3.5 top-3" />
                <input
                  type="text"
                  required
                  value={profile.business_name}
                  onChange={(e) =>
                    setProfile({ ...profile, business_name: e.target.value })
                  }
                  className="w-full pl-10 pr-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs text-slate-800 focus:outline-none focus:ring-2 focus:ring-[#00D2FF]"
                />
              </div>
            </div>

            <div>
              <label className="block text-[11px] font-bold text-slate-700 uppercase tracking-wider mb-1">
                Teléfono WhatsApp (para recibir pedidos)
              </label>
              <div className="relative">
                <Phone className="w-4 h-4 text-slate-400 absolute left-3.5 top-3" />
                <input
                  type="text"
                  required
                  placeholder="+584121234567"
                  value={profile.phone}
                  onChange={(e) =>
                    setProfile({ ...profile, phone: e.target.value })
                  }
                  className="w-full pl-10 pr-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs text-slate-800 focus:outline-none focus:ring-2 focus:ring-[#00D2FF]"
                />
              </div>
            </div>

            <div>
              <label className="block text-[11px] font-bold text-slate-700 uppercase tracking-wider mb-1">
                Enlace / Slug del Catálogo Público
              </label>
              <div className="relative">
                <Globe className="w-4 h-4 text-slate-400 absolute left-3.5 top-3" />
                <input
                  type="text"
                  required
                  value={profile.slug}
                  onChange={(e) =>
                    setProfile({ ...profile, slug: e.target.value })
                  }
                  className="w-full pl-10 pr-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs text-slate-800 focus:outline-none focus:ring-2 focus:ring-[#00D2FF]"
                />
              </div>
              <span className="text-[10px] text-slate-400 mt-1 block">
                Tu catálogo estará en: mercadeo.app/{profile.slug}
              </span>
            </div>

            {successMsg && (
              <div className="flex items-center gap-2 p-3 bg-emerald-50 text-emerald-700 rounded-xl text-xs font-bold">
                <CheckCircle2 className="w-4 h-4 shrink-0" />
                <span>¡Cambios guardados con éxito!</span>
              </div>
            )}

